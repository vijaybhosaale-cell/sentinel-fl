# Flower + PyTorch (CPU) + Opacus image for the sentinel_flower engine.
FROM python:3.11-slim
WORKDIR /app
COPY requirements.txt requirements-flower.txt ./
RUN pip install --no-cache-dir -r requirements-flower.txt --extra-index-url https://download.pytorch.org/whl/cpu
COPY . .
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app
CMD ["python", "-m", "sentinel_flower.simulate", "--attack", "label_flip"]
