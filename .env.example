# Copy to .env (never commit it). Without SMTP settings, alert e-mails go to nodes/aggregator/outbox/.
SENTINEL_ADMIN_TOKEN=change-me
SENTINEL_SMTP_HOST=smtp.gmail.com
SENTINEL_SMTP_PORT=587
SENTINEL_SMTP_USER=your.address@gmail.com
SENTINEL_SMTP_PASSWORD=your-16-character-app-password
SENTINEL_SMTP_FROM=SENTINEL-FL <your.address@gmail.com>
SENTINEL_ALERT_TO=compliance.officer@example.com
